<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/cosmic_gradient"
    android:padding="16dp">

    <!-- Connection Status -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/connectionStatusCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_tv_generic"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDeviceName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TV Device"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvConnectionStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="กำลังเชื่อมต่อ..."
                    android:textSize="14sp"
                    android:textColor="@color/connecting_orange"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWakeTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ปลุก"
                style="@style/Widget.ColorControl.Button.Outlined"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDisconnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ตัดการเชื่อมต่อ"
                style="@style/Widget.ColorControl.Button.Outlined" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- TV Remote View -->
    <com.maassoft.colorcontrol.widgets.TvRemoteView
        android:id="@+id/tvRemoteView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Quick Actions Bar -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">

            <com.google.android.material.button.MaterialButton
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="เสียงขึ้น"
                style="@style/Widget.ColorControl.Button.Outlined"
                android:drawableStart="@drawable/ic_volume_up"
                android:layout_marginEnd="4dp" />

            <com.google.android.material.button.MaterialButton
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="เสียงลง"
                style="@style/Widget.ColorControl.Button.Outlined"
                android:drawableStart="@drawable/ic_volume_down"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

            <com.google.android.material.button.MaterialButton
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ปิดเสียง"
                style="@style/Widget.ColorControl.Button.Outlined"
                android:drawableStart="@drawable/ic_mute"
                android:layout_marginStart="4dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>