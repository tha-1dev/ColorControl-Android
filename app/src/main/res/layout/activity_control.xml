<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cosmic_gradient"
    android:padding="16dp">

    <!-- Connection Status Card (Header) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/connectionStatusCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/gray_50">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <!-- TV Icon (Using a placeholder, the actual one will be set in Java) -->
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_tv_generic"
                app:tint="@color/cosmic_purple"
                android:layout_marginEnd="16dp"
                android:contentDescription="TV Icon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDeviceName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="LG OLED TV 65&quot;"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/tvConnectionStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="กำลังเชื่อมต่อ..."
                    android:textSize="14sp"
                    android:textColor="@color/connecting_orange"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Disconnect Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDisconnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ตัดการเชื่อมต่อ"
                android:textSize="12sp"
                style="@style/Widget.ColorControl.Button.Secondary"
                app:icon="@drawable/ic_disconnect_icon_placeholder"
                app:iconTint="@color/disconnected_red"
                android:textColor="@color/disconnected_red"
                app:strokeColor="@color/disconnected_red"
                android:layout_marginStart="8dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Powered By Thai-Dev Footer -->
    <TextView
        android:id="@+id/tvFooterControl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Powered By Thai-Dev"
        android:textSize="12sp"
        android:textColor="@color/gray_300"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- TV Remote View -->
    <!-- ConstraintLayout ถูกปรับเพื่อให้ RemoteView อยู่เหนือ Footer -->
    <com.maassoft.colorcontrol.widgets.TvRemoteView
        android:id="@+id/tvRemoteView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@drawable/cosmic_dark_card"
        app:layout_constraintTop_toBottomOf="@id/connectionStatusCard"
        app:layout_constraintBottom_toTopOf="@id/tvFooterControl"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Floating Wake Button (for quick access when TV is off, can be hidden/shown by Java) -->
    <com.maassoft.colorcontrol.widgets.CosmicButton
        android:id="@+id/btnWakeTv"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:text="ปลุก"
        android:textSize="12sp"
        android:textColor="@color/white"
        app:cosmicColor1="#4FC3F7"
        app:cosmicColor2="#7E57C2"
        app:cornerRadius="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvFooterControl"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="12dp"
        android:elevation="12dp"
        android:visibility="visible"
        tools:visibility="visible"
        android:stateListAnimator="@null" />

</androidx.constraintlayout.widget.ConstraintLayout>
