<resources>
    <!-- Base application theme. -->
    <style name="Theme.ColorControl" parent="Theme.Material3.Light.DarkActionBar">
        <item name="colorPrimary">@color/primary_color</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent_color</item>
        <item name="colorSecondaryVariant">@color/cosmic_purple</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:windowBackground">@color/cosmic_dark</item>
    </style>

    <style name="Theme.ColorControl.Launch" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/cosmic_gradient</item>
    </style>

    <style name="Theme.ColorControl.Fullscreen" parent="Theme.ColorControl">
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Theme.ColorControl.Dialog" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowBackground">@drawable/cosmic_gradient</item>
    </style>

    <!-- Button Styles -->
    <style name="Widget.ColorControl.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary_color</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.ColorControl.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/primary_color</item>
        <item name="android:textColor">@color/primary_color</item>
    </style>

    <style name="Widget.ColorControl.Button.Outlined" parent="Widget.Material3.Button">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">@color/primary_color</item>
    </style>

    <!-- Connection Button Style -->
    <style name="ConnectionButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
    </style>
</resources>